set clipboard+=unnamedplus
set leader=" "
nnoremap ; <Nop>

nnoremap + <C-a>
nnoremap - <C-x>

nnoremap <D-d> <C-d>zz
nnoremap <D-u> <C-u>zz

vnoremap x "_x

nnoremap <D-a> gg<S-v>G
nnoremap <CR> ciw

nnoremap U :redo<CR>

nnoremap <expr> i len(getline('.')) == 0 ? '"_cc' : 'i'
nnoremap <expr> dd getline('.') =~ '^\s*$' ? '"_dd' : 'dd'

nnoremap ;h :action ShowHoverInfo<CR>
nnoremap <C-,> :action Run<CR>
nnoremap ;d :action ActivateProblemsViewToolWindow<CR>
nnoremap <Space>r :action RenameElement<CR>
